# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
MONGODB_URI=mongodb://localhost:27017/robe-rent

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Used by `npm run seed:admin` to bootstrap the first admin account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ---- Client / CORS ----
CLIENT_ORIGIN=http://localhost:5173

# ---- Booking rules ----
BOOKING_BUFFER_DAYS=1
MIN_RENTAL_DAYS=1
MAX_RENTAL_DAYS=30
# Default country for phone-number validation (ISO 3166-1 alpha-2).
DEFAULT_PHONE_COUNTRY=TN

# ---- Logging ----
LOG_LEVEL=debug

# ---- Email (scaffolding only — not yet wired) ----
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Robe-Rent <no-reply@robe-rent.tn>"
